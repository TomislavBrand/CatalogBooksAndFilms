@model CatalogBooksAndFilms.ViewModels.BookCreateViewModel
@{
    var authors = ViewBag.Authors as List<CatalogBooksAndFilms.Entities.Author>;
}

<h2>Create Book</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Year</label>
        <input asp-for="Year" class="form-control" />
    </div>

    @{
        var genres = ViewBag.Genres as List<CatalogBooksAndFilms.Entities.Genre>;
    }

    <div class="mb-3">
        <label>Genre</label>
        <select asp-for="GenreId" class="form-control">
            <option value="">-- Select Genre --</option>

            @foreach (var genre in genres)
            {
                <option value="@genre.Id">@genre.Name</option>
            }
        </select>
    </div>

    <h4>Authors</h4>

    @foreach (var author in authors)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   name="SelectedAuthorIds"
                   value="@author.Id" />

            <label class="form-check-label">
                @author.Name
            </label>
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">
        Save
    </button>
</form>